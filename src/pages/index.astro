---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form
            method="get"
            class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6"
            data-testid="game-filters"
          >
            <fieldset>
              <legend class="mb-4 text-lg font-medium text-slate-100">Filter games</legend>

              <div class="grid gap-6 lg:grid-cols-[2fr_1fr_auto] lg:items-end">
                <div>
                  <p class="mb-3 block text-sm font-medium text-slate-200">Categories</p>
                  <div class="grid gap-3 sm:grid-cols-2" data-testid="category-filters">
                    {categories.map((category) => (
                      <label class="flex items-center gap-2 text-sm text-slate-300">
                        <input
                          type="checkbox"
                          name="category"
                          value={category.id}
                          class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                          data-testid={`category-filter-${category.id}`}
                        />
                        <span>{category.name}</span>
                      </label>
                    ))}
                  </div>
                </div>

                <label class="block text-sm font-medium text-slate-200">
                  <span class="mb-2 block">Publisher</span>
                  <select
                    name="publisher"
                    class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    data-testid="publisher-filter"
                  >
                    <option value="">All publishers</option>
                    {publishers.map((publisher) => (
                      <option value={publisher.id}>{publisher.name}</option>
                    ))}
                  </select>
                </label>

                <div class="flex gap-3">
                  <button
                    type="submit"
                    class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    data-testid="apply-filters"
                  >
                    Apply filters
                  </button>
                  <a
                    href="/"
                    class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    data-testid="reset-filters"
                  >
                    Reset
                  </a>
                </div>
              </div>
            </fieldset>
          </form>

          <p class="mb-4 text-sm text-slate-400" data-testid="filter-summary" aria-live="polite"></p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filtered-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const summary = document.querySelector<HTMLElement>('[data-testid="filter-summary"]');

  if (form && grid && emptyState && summary) {
    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set(params.getAll('category'));
    const selectedPublisher = params.get('publisher') ?? '';
    const categoryInputs = form.querySelectorAll<HTMLInputElement>('input[name="category"]');
    const publisherInput = form.querySelector<HTMLSelectElement>('select[name="publisher"]');

    categoryInputs.forEach((input) => {
      input.checked = selectedCategories.has(input.value);
    });
    if (publisherInput) {
      publisherInput.value = selectedPublisher;
    }

    const visibleCards = cards.filter((card) => {
      const categoryId = card.dataset.categoryId ?? '';
      const publisherId = card.dataset.publisherId ?? '';
      const matchesCategory =
        selectedCategories.size === 0 || selectedCategories.has(categoryId);
      const matchesPublisher = selectedPublisher === '' || publisherId === selectedPublisher;

      card.classList.toggle('hidden', !(matchesCategory && matchesPublisher));
      return matchesCategory && matchesPublisher;
    });

    const hasFilters = selectedCategories.size > 0 || selectedPublisher !== '';
    summary.textContent = hasFilters
      ? `${visibleCards.length} ${visibleCards.length === 1 ? 'game' : 'games'} match the selected filters.`
      : `${cards.length} ${cards.length === 1 ? 'game' : 'games'} available.`;
    grid.classList.toggle('hidden', visibleCards.length === 0);
    emptyState.classList.toggle('hidden', visibleCards.length !== 0);
  }
</script>
